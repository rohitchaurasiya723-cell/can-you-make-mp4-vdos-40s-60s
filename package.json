{
  "name": "mp4-video-studio-40s-60s",
  "version": "1.0.0",
  "description": "High-Definition 40s to 60s MP4 Video Generator with procedural audio and animations",
  "main": "index.html",
  "scripts": {
    "start": "npx -y serve . -l 3000",
    "generate": "node generate-video.js 45 public/sample_45s.mp4",
    "generate:60": "node generate-video.js 60 public/sample_60s.mp4"
  },
  "dependencies": {
    "@napi-rs/canvas": "^0.1.66",
    "ffmpeg-static": "^5.2.0"
  }
}
